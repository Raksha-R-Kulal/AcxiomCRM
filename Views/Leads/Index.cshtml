@model IEnumerable<AcxiomCRM.Models.Lead>

@{
    ViewData["Title"] = "Lead Management";
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold">Lead Management</h2>
            <p class="text-muted">Track and manage your sales leads.</p>
        </div>
        <a asp-controller="Leads"
   asp-action="Create"
   class="btn btn-primary">
    + Add New Lead
</a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }

    <form method="get" class="row g-2 mb-3">
        <div class="col-md-5">
            <input name="search" value="@ViewBag.Search"
                   class="form-control" placeholder="Search leads..." />
        </div>
        <div class="col-md-3">
            <select name="status" class="form-select">
                <option value="">All statuses</option>
                <option value="New">New</option>
                <option value="Contacted">Contacted</option>
                <option value="Qualified">Qualified</option>
                <option value="Converted">Converted</option>
                <option value="Lost">Lost</option>
            </select>
        </div>
        <div class="col-md-4">
            <button class="btn btn-dark">Search / Filter</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Clear</a>
        </div>
    </form>

    <div class="card border-0 shadow-sm">
        <div class="card-body table-responsive">
            <table class="table table-hover align-middle">
                <thead>
                    <tr>
                        <th>Lead</th>
                        <th>Company</th>
                        <th>Email</th>
                        <th>Phone</th>
                        <th>Source</th>
                        <th>Value</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var lead in Model)
                    {
                        <tr>
                            <td>
                                <strong>@lead.LeadName</strong><br />
                                <small class="text-muted">@lead.LeadCode</small>
                            </td>
                            <td>@lead.CompanyName</td>
                            <td>@lead.Email</td>
                            <td>@lead.Phone</td>
                            <td>@lead.Source</td>
                            <td>₹@lead.ExpectedValue.ToString("N0")</td>
                            <td>
                                <span class="badge bg-primary">@lead.Status</span>
                            </td>
                            <td>
                                <a asp-action="Edit" asp-route-id="@lead.LeadId"
                                   class="btn btn-sm btn-outline-primary">Edit</a>
                                <a asp-action="Delete" asp-route-id="@lead.LeadId"
                                   class="btn btn-sm btn-outline-danger">Delete</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

            @if (!Model.Any())
            {
                <div class="text-center text-muted py-4">
                    No leads found. Add your first lead!
                </div>
            }
        </div>
    </div>
</div>