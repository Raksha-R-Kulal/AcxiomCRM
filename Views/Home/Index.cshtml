@{
    ViewData["Title"] = "Dashboard";
}

<style>
    body {
        background: #f4f6fb;
    }

    .crm-wrapper {
        padding: 25px;
    }

    .welcome-text {
        font-size: 25px;
        font-weight: 700;
        color: #172554;
    }

    .subtitle {
        color: #64748b;
        font-size: 14px;
    }

    .stat-card {
        background: white;
        border: none;
        border-radius: 14px;
        padding: 22px;
        box-shadow: 0 3px 15px rgba(0,0,0,.04);
        height: 100%;
    }

    .stat-label {
        color: #64748b;
        font-size: 13px;
    }

    .stat-value {
        font-size: 27px;
        font-weight: 700;
        color: #172554;
        margin-top: 10px;
    }

    .stat-icon {
        width: 43px;
        height: 43px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 21px;
    }

    .panel {
        background: white;
        padding: 23px;
        border-radius: 14px;
        box-shadow: 0 3px 15px rgba(0,0,0,.04);
        height: 100%;
    }

    .panel-title {
        font-weight: 700;
        color: #172554;
    }

    .table th {
        color: #64748b;
        font-size: 12px;
        font-weight: 600;
        border-bottom: 1px solid #e9edf5;
    }

    .table td {
        padding: 15px 8px;
        font-size: 13px;
        vertical-align: middle;
    }

    .status {
        padding: 6px 11px;
        border-radius: 20px;
        font-size: 11px;
        font-weight: 600;
    }

    .status-qualified {
        background: #dcfce7;
        color: #15803d;
    }

    .status-new {
        background: #dbeafe;
        color: #1d4ed8;
    }

    .status-pending {
        background: #fef3c7;
        color: #b45309;
    }

    .action-btn {
        background: #2563eb;
        color: white;
        border-radius: 8px;
        padding: 10px 17px;
        text-decoration: none;
        font-size: 13px;
        border: none;
    }

    .action-btn:hover {
        background: #1d4ed8;
        color: white;
    }

    .chart-container {
        height: 250px;
        position: relative;
    }
</style>

<div class="crm-wrapper">

    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">
        <div>
            <div class="welcome-text">Welcome to AcxiomCRM 👋</div>
            <div class="subtitle">
                Here's what's happening with your business today.
            </div>
        </div>

       <a asp-controller="Leads"
   asp-action="Create"
   class="btn btn-primary">
    + Add New Lead
</a>
    </div>

    <!-- KPI Cards -->
    <div class="row g-3 mb-4">

        <div class="col-md-6 col-xl-3">
            <div class="stat-card">
                <div class="d-flex justify-content-between">
                    <span class="stat-label">Total Customers</span>
                    <div class="stat-icon" style="background:#dbeafe;color:#2563eb">👥</div>
                </div>
                <div class="stat-value">248</div>
                <small class="text-success">Customer records</small>
            </div>
        </div>

        <div class="col-md-6 col-xl-3">
            <div class="stat-card">
                <div class="d-flex justify-content-between">
                    <span class="stat-label">Total Leads</span>
                    <div class="stat-icon" style="background:#f3e8ff;color:#9333ea">🎯</div>
                </div>
                <div class="stat-value">86</div>
                <small class="text-success">Lead records</small>
            </div>
        </div>

        <div class="col-md-6 col-xl-3">
            <div class="stat-card">
                <div class="d-flex justify-content-between">
                    <span class="stat-label">Open Opportunities</span>
                    <div class="stat-icon" style="background:#dcfce7;color:#16a34a">📈</div>
                </div>
                <div class="stat-value">32</div>
                <small class="text-success">Active opportunities</small>
            </div>
        </div>

        <div class="col-md-6 col-xl-3">
            <div class="stat-card">
                <div class="d-flex justify-content-between">
                    <span class="stat-label">Pipeline Value</span>
                    <div class="stat-icon" style="background:#ffedd5;color:#ea580c">💰</div>
                </div>
                <div class="stat-value">₹12.8L</div>
                <small class="text-success">Open sales pipeline</small>
            </div>
        </div>

    </div>

    <!-- Charts -->
    <div class="row g-3 mb-4">

        <div class="col-lg-8">
            <div class="panel">
                <h6 class="panel-title">Monthly Sales Performance</h6>
                <p class="subtitle">Sales overview for the year</p>
                <div class="chart-container">
                    <canvas id="salesChart"></canvas>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="panel">
                <h6 class="panel-title">Lead Status</h6>
                <p class="subtitle">Lead distribution</p>
                <div class="chart-container">
                    <canvas id="leadChart"></canvas>
                </div>
            </div>
        </div>

    </div>

    <!-- Recent Leads -->
    <div class="panel">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <div>
                <h6 class="panel-title mb-1">Recent Leads</h6>
                <small class="subtitle">Latest sales enquiries</small>
            </div>
            <a href="#" class="text-primary text-decoration-none small">
                View all
            </a>
        </div>

        <div class="table-responsive">
            <table class="table">
                <thead>
                    <tr>
                        <th>LEAD NAME</th>
                        <th>COMPANY</th>
                        <th>EMAIL</th>
                        <th>STATUS</th>
                        <th>VALUE</th>
                    </tr>
                </thead>

                <tbody>
                    <tr>
                        <td>Rahul Sharma</td>
                        <td>Tech Solutions</td>
                        <td>rahul@example.com</td>
                        <td><span class="status status-qualified">Qualified</span></td>
                        <td>₹80,000</td>
                    </tr>

                    <tr>
                        <td>Priya Nair</td>
                        <td>Global Systems</td>
                        <td>priya@example.com</td>
                        <td><span class="status status-new">New</span></td>
                        <td>₹45,000</td>
                    </tr>

                    <tr>
                        <td>Arjun Rao</td>
                        <td>Digital Works</td>
                        <td>arjun@example.com</td>
                        <td><span class="status status-pending">Contacted</span></td>
                        <td>₹65,000</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>

</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<script>
    new Chart(document.getElementById('salesChart'), {
        type: 'line',
        data: {
            labels: ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun'],
            datasets: [{
                label: 'Sales',
                data: [20, 35, 28, 50, 42, 70],
                borderColor: '#2563eb',
                backgroundColor: 'rgba(37,99,235,0.10)',
                fill: true,
                tension: 0.4,
                borderWidth: 3
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false
        }
    });

    new Chart(document.getElementById('leadChart'), {
        type: 'doughnut',
        data: {
            labels: ['New', 'Contacted', 'Qualified', 'Converted', 'Lost'],
            datasets: [{
                data: [25, 20, 30, 15, 10],
                backgroundColor: [
                    '#3b82f6',
                    '#f59e0b',
                    '#22c55e',
                    '#8b5cf6',
                    '#ef4444'
                ],
                borderWidth: 0
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false
        }
    });
</script>